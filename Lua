local function CreateTab(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Parent = PageFolder
    page.Position = UDim2.new(0, 10, 0, 86)
    page.Size = UDim2.new(1, -20, 1, -96)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.CanvasSize = UDim2.new(0, 0, 0, 380)
    page.ScrollBarThickness = 4

    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)

    local tabBtn = Instance.new("TextButton")
    tabBtn.Parent = TabContainer
    tabBtn.Size = UDim2.new(0.32, 0, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(32, 34, 37)
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(185, 187, 190)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 13

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = tabBtn

    tabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(PageFolder:GetChildren()) do p.Visible = false end
        for _, b in pairs(TabContainer:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(32, 34, 37)
                b.TextColor3 = Color3.fromRGB(185, 187, 190)
            end
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242) -- Discord Blurple Active
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    return page, tabBtn
end

