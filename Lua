local function GetSimSimiReply(text)
    if #LearnedChatLogs > 0 and math.random(1, 100) <= 30 then
        local data = LearnedChatLogs[math.random(1, #LearnedChatLogs)]
        return string.format("กูจำคุณ %s พูดว่า: \"%s\" กูเลยเอามาด่ามึงแทนไอ้%s!", data.speaker, data.text, USER_NAME)
    end
    local lowerText = string.lower(text)
    for _, item in ipairs(SimSimiDict) do
        for _, key in ipairs(item.keywords) do
            if string.find(lowerText, key) then
                return item.replies[math.random(1, #item.replies)]
            end
        end
    end
    return RandomReplies[math.random(1, #RandomReplies)]
end

