local function playCuteVoice(text)
    task.spawn(function()
        pcall(function()
            local encodedText = HttpService:UrlEncode(text)
            local ttsUrl = "https://translate.google.com/translate_tts?ie=UTF-8&tl=th&client=tw-ob&q=" .. encodedText
            local fileName = "SunVoice_Temp.mp3"
            
            if writefile and getcustomasset then
                writefile(fileName, game:HttpGet(ttsUrl))
                local sound = Instance.new("Sound")
                sound.SoundId = getcustomasset(fileName)
                sound.PlaybackSpeed = 1.05 -- ปรับความแหลมลงให้อยู่ในระดับนุ่มนวลพอดี
                sound.Volume = 3
                sound.Parent = game:GetService("SoundService")
                sound:Play()
                sound.Ended:Connect(function() sound:Destroy() end)
            end
        end)
    end)
end

