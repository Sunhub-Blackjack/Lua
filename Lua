-- 🎯 HITBOX ENGINE (MULTI-PART & TRANSPARENCY SUPPORT)
-- ----------------------------------------------------------------- --
local function ResetPlayerCharacter(player)
    if player.Character then
        pcall(function()
            if player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.Material = Enum.Material.Plastic
            end
            if player.Character:FindFirstChild("Head") then
                local head = player.Character.Head
                head.Size = Vector3.new(1.2, 1.2, 1.2)
                head.Transparency = 0
            end
        end)
    end
end

local function UpdateHitboxes()
    if not ScriptActive then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            pcall(function()
                local part = player.Character:FindFirstChild(HitboxTargetPart)
                if HitboxEnabled and part then
                    part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                    part.Transparency = HitboxTransparency
                    part.BrickColor = BrickColor.new("Really blue")
                    part.Material = Enum.Material.Neon
                    part.CanCollide = false
                else
                    ResetPlayerCharacter(player)
                end
            end)
        end
    end
end

RunService.RenderStepped:Connect(function()
    if HitboxEnabled then UpdateHitboxes() end
    
    -- Update FOV Circle Position
    if FovCircle then
        FovCircle.Radius = AimFov
        FovCircle.Visible = ShowFovCircle and AimbotEnabled and ScriptActive
        FovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end)

-- ----------------------------------------------------------------- --
-- 🔫 MOBILE-FRIENDLY AIMBOT ENGINE
-- ----------------------------------------------------------------- --
local function GetClosestTarget()
    local Closest = nil
    local ShortestDist = AimFov
    local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
            local Pos, OnScreen = Camera:WorldToViewportPoint(v.Character.Head.Position)
            if OnScreen then
                local Dist = (Vector2.new(Pos.X, Pos.Y) - ScreenCenter).Magnitude
                if Dist < ShortestDist then
                    Closest = v
                    ShortestDist = Dist
                end
            end
        end
    end
    return Closest
end

local ConnectionAimbot = RunService.RenderStepped:Connect(function()
    if AimbotEnabled and ScriptActive then
        local Target = GetClosestTarget()
        if Target and Target.Character and Target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Character.Head.Position)
        end
    end
end)

