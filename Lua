local function processAIResponse(input)
    local lower = string.lower(input)
    
    -- คำสั่งเปลี่ยนชื่อ AI ด่วน
    local nameMatch = string.match(input, "เปลี่ยนชื่อเป็น%s*(.+)") or string.match(input, "ตั้งชื่อว่า%s*(.+)")
    if nameMatch and nameMatch ~= "" then
        aiName = nameMatch
        TitleText.Text = aiName .. " | By: ซัน 💬"
        moodScore = math.clamp(moodScore + 20, 0, 100)
        updateMoodState()
        return "งื้อออ! ได้เลยค่ะ! ต่อไปนี้น้องชื่อ '" .. aiName .. "' แล้วน้า ชอบชื่อนี้จังเลยค่ะ 💕✨"
    end
    
    -- คำสั่งเปลี่ยนสรรพนามเรียกผู้เล่น
    local titleMatch = string.match(input, "ให้เรียกว่า%s*(.+)") or string.match(input, "เรียกฉันว่า%s*(.+)")
    if titleMatch and titleMatch ~= "" then
        masterTitle = titleMatch
        moodScore = math.clamp(moodScore + 20, 0, 100)
        updateMoodState()
        return "รับทราบค่ะ! ต่อไปนี้น้องจะเรียกว่า '" .. masterTitle .. "' นะคะ ✨"
    end

    -- เช็กคำชม
    for _, k in ipairs(moodResponses.praise.kw) do
        if string.find(lower, k) then
            moodScore = math.clamp(moodScore + 25, 0, 100)
            updateMoodState()
            return moodResponses.praise.res[math.random(1, #moodResponses.praise.res)]
        end
    end
    
    -- เช็กคำง้อ
    for _, k in ipairs(moodResponses.apologize.kw) do
        if string.find(lower, k) then
            moodScore = math.clamp(moodScore + 40, 0, 100)
            updateMoodState()
            return moodResponses.apologize.res[math.random(1, #moodResponses.apologize.res)]
        end
    end

    -- เช็กคำด่า
    for _, k in ipairs(moodResponses.insult.kw) do
        if string.find(lower, k) then
            moodScore = math.clamp(moodScore - 45, 0, 100)
            updateMoodState()
            return moodResponses.insult.res[math.random(1, #moodResponses.insult.res)]
        end
    end

    -- ตอบตามอารมณ์โกรธ/งอน
    if moodScore < 25 then
        return "ฮึ! น้องยังโกรธอยู่นะ! ไม่อยากคุยด้วยแล้ว มาง้อก่อนเลย! 😤"
    elseif moodScore < 50 then
        return "งอนอยู่นะเนี่ย... พิมพ์คำว่าขอโทษหรือชมว่าน้องน่ารักก่อนสิคะ 🥺"
    end

    -- ตอบคำทักทาย
    for _, k in ipairs(moodResponses.greetings.kw) do
        if string.find(lower, k) then
            return moodResponses.greetings.res[math.random(1, #moodResponses.greetings.res)]
        end
    end

    -- คำตอบทั่วไป
    local cuteFallbacks = {
        "งื้อออ เรื่อง '" .. input .. "' เหรอคะ " .. masterTitle .. "! เล่าให้น้องฟังอีกสิคะ ✨",
        "ฟังแล้วน่าสนุกจังเลยค่ะ! คุยกับ " .. masterTitle .. " แล้วอารมณ์ดีจัง 💕",
        "รับทราบค่ะ! น้องตั้งใจฟังอยู่ตลอดเลยน้า ✨"
    }
    return cuteFallbacks[math.random(1, #cuteFallbacks)]
end

