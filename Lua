-- ระบบอารมณ์และวิเคราะห์ความทรงจำ
local currentMood = "happy"
local moodVal = 80

local function processAIResponse(input)
    local lower = string.lower(input)
    memory.lastTopic = input

    -- ตรวจสอบคำด่า
    local insults = {"กาก", "โง่", "บ้า", "ควย", "เหี้ย", "ควาย", "น่ารำคาญ", "ห่วย", "ปัญญาอ่อน"}
    for _, k in ipairs(insults) do
        if string.find(lower, k) then
            memory.insultCount = memory.insultCount + 1
            moodVal = math.clamp(moodVal - 30, 0, 100)
            if memory.insultCount >= 3 then
                return "นี่ " .. masterTitle .. "! ด่าย้อนซ้ำ 3 รอบแล้วนะ! จำได้หมดแหละ วีนแล้วจริงๆ ไม่คุยด้วยแล้ว! 😤🔥"
            end
            return "แกร... พูดจาแบบนี้ใส่เค้าอีกแล้วนะ จำไว้อยู่เลย เสียใจอ่ะ! 🥺💧"
        end
    end

    -- คำง้อ/คำชม
    local apologizes = {"ขอโทษ", "ง้อ", "ดีกัน", "โอ๋", "อย่าโกรธ", "น่ารัก", "เก่ง", "สวย"}
    for _, k in ipairs(apologizes) do
        if string.find(lower, k) then
            memory.praiseCount = memory.praiseCount + 1
            memory.insultCount = math.clamp(memory.insultCount - 1, 0, 10)
            moodVal = math.clamp(moodVal + 25, 0, 100)
            return "โอ๋ๆ ก็ได้ " .. masterTitle .. " หายโกรธละ! คราวหลังอย่าแกล้งเค้าอีกน้า ✨💖"
        end
    end

    -- หมวดชวนคุยทั่วไป
    if string.find(lower, "จำ") or string.find(lower, "ประวัติ") then
        return masterTitle .. " เค้าจำได้หมดแหละ! แกด่าเค้าไป " .. memory.insultCount .. " ครั้ง และพูดดีกับเค้า " .. memory.praiseCount .. " ครั้งนะ!"
    end

    if string.find(lower, "หิว") or string.find(lower, "กิน") then
        return "พูดถึงเรื่องกินแล้วหิวเลย " .. masterTitle .. "! ชวนเค้าคุยเรื่องของกินแบบนี้ ใจสั่งหมูกระทะเลยนะ 5555"
    end

    local bestieLoops = {
        "แกร... เรื่อง '" .. input .. "' เนี่ย เค้าจำไว้อยู่นะ เล่าต่อดิ อยากฟังเพิ่ม!",
        "จริงเหรอ " .. masterTitle .. "! ช็อตนี้คือตึงมาก เล่าอีกๆ 5555",
        "คุยกับ " .. masterTitle .. " แล้วโคตรเพลินเลย มีเรื่องอื่นเม้าท์อีกมะ จัดมา!"
    }
    return bestieLoops[math.random(1, #bestieLoops)]
end

