local function MakeBtn(text, callback)
    local btn = Instance.new("TextButton", Frame)
    btn.Size, btn.BackgroundColor3, btn.Text, btn.TextColor3 = UDim2.new(0.9, 0, 0, 34), Color3.fromRGB(25, 35, 50), text, Color3.fromRGB(255, 255, 255)
    btn.Font, btn.TextSize = Enum.Font.GothamBold, 10
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function() callback(btn) end)
    return btn
end

