local function getRichResponse(t)
    t = string.lower(t)
    for _, cat in pairs(aiKnowledge) do
        for _, k in ipairs(cat.kw) do
            if string.find(t, k) then
                return cat.res[math.random(1, #cat.res)]
            end
        end
    end
    local fallbacks = {
        "จัดไปเลยค่ะนายท่าน ยิงให้ยับเลยน้า ✨",
        "รับทราบค่ะ! มีอะไรให้น้องช่วยอีกไหมคะ",
        "น้องอยู่ตรงนี้เสมอ พิมพ์คุยกับน้องได้เรื่อยๆ เลยน้า 💕",
        "ลองเปิดมองทะลุดูยังคะ เห็นชัดแจ๋วเลยน้า 👁️"
    }
    return fallbacks[math.random(1, #fallbacks)]
end

